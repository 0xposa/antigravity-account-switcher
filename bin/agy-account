#!/usr/bin/env python3
import os
import sys
import json
import base64
import shutil
import subprocess

HOME = os.environ.get("HOME", os.path.expanduser("~"))
AGY_DIR = os.path.join(HOME, ".gemini", "antigravity-cli")
ACTIVE_TOKEN = os.path.join(AGY_DIR, "antigravity-oauth-token")
ACCOUNTS_DIR = os.path.join(AGY_DIR, "accounts")

os.makedirs(ACCOUNTS_DIR, exist_ok=True)

def get_email_from_token_file(filepath):
    if not os.path.exists(filepath):
        return None
    try:
        with open(filepath, "r", encoding="utf-8") as f:
            data = json.load(f)
        id_token = data.get("id_token")
        if id_token:
            parts = id_token.split(".")
            if len(parts) >= 2:
                payload_part = parts[1]
                payload_part += "=" * (-len(payload_part) % 4)
                payload_json = json.loads(base64.urlsafe_b64decode(payload_part))
                return payload_json.get("email")
    except Exception:
        pass
    return None

def get_expiry(filepath):
    try:
        with open(filepath, "r", encoding="utf-8") as f:
            data = json.load(f)
        expiry_str = data.get("token", {}).get("expiry")
        if expiry_str:
            return expiry_str.split(".")[0].replace("T", " ")
    except Exception:
        pass
    return "N/A"

def get_accounts():
    if not os.path.exists(ACCOUNTS_DIR):
        return []
    files = sorted([f for f in os.listdir(ACCOUNTS_DIR) if f.endswith(".token")])
    accs = []
    for f in files:
        path = os.path.join(ACCOUNTS_DIR, f)
        email = get_email_from_token_file(path) or f[:-6]
        accs.append({"file": f, "path": path, "email": email, "expiry": get_expiry(path)})
    return accs

def is_active(path):
    if not os.path.exists(ACTIVE_TOKEN) or not os.path.exists(path):
        return False
    try:
        with open(ACTIVE_TOKEN, "rb") as f1, open(path, "rb") as f2:
            return f1.read() == f2.read()
    except Exception:
        return False

def save_current(label=None):
    if not os.path.exists(ACTIVE_TOKEN):
        print("❌ Tidak ada token aktif yang ditemukan.")
        return False
    email = get_email_from_token_file(ACTIVE_TOKEN)
    target_name = label if label else (email if email else "default")
    if not target_name.endswith(".token"):
        target_name += ".token"
    dest = os.path.join(ACCOUNTS_DIR, target_name)
    shutil.copy2(ACTIVE_TOKEN, dest)
    print(f"✅ Token berhasil disimpan ke daftar akun: {target_name} ({email})")
    return True

def list_accounts():
    accounts = get_accounts()
    current_email = get_email_from_token_file(ACTIVE_TOKEN)
    print("\n================= DAFTAR AKUN ANTIGRAVITY =================")
    if not accounts:
        print("Belum ada akun tersimpan di pool.")
        if current_email:
            print(f"Akun aktif saat ini: {current_email} (belum disimpan ke daftar)")
            print("Gunakan: agy-account save untuk menyimpannya.")
    else:
        for idx, acc in enumerate(accounts, 1):
            active_marker = " \033[1;32m[AKTIF]\033[0m" if is_active(acc["path"]) else ""
            print(f" {idx}. {acc['email']}{active_marker}")
            print(f"    File: {acc['file']} | Exp: {acc['expiry']}")
    print("===========================================================\n")

def switch_account(identifier):
    accounts = get_accounts()
    if not accounts:
        print("❌ Belum ada akun yang terdaftar.")
        return False
    target = None
    if identifier.isdigit():
        idx = int(identifier) - 1
        if 0 <= idx < len(accounts):
            target = accounts[idx]
    else:
        for acc in accounts:
            if identifier.lower() in acc["email"].lower() or identifier.lower() in acc["file"].lower():
                target = acc
                break
    if not target:
        print(f"❌ Akun '{identifier}' tidak ditemukan.")
        return False
    
    shutil.copy2(target["path"], ACTIVE_TOKEN)
    print(f"✅ Berhasil beralih ke akun: \033[1;32m{target['email']}\033[0m")
    return True

def rotate_account():
    accounts = get_accounts()
    if len(accounts) < 2:
        print("⚠️ Perlu minimal 2 akun di daftar untuk melakukan rotasi.")
        return False
    current_idx = -1
    for idx, acc in enumerate(accounts):
        if is_active(acc["path"]):
            current_idx = idx
            break
    next_idx = (current_idx + 1) % len(accounts)
    next_acc = accounts[next_idx]
    shutil.copy2(next_acc["path"], ACTIVE_TOKEN)
    print(f"🔄 Rotasi otomatis berhasil! Akun aktif sekarang: \033[1;32m{next_acc['email']}\033[0m")
    return True

def add_account():
    print("➕ Menyiapkan penambahan akun baru tanpa logout akun lama...")
    if os.path.exists(ACTIVE_TOKEN):
        curr_email = get_email_from_token_file(ACTIVE_TOKEN)
        curr_name = curr_email if curr_email else "akun_sebelumnya"
        save_current(curr_name)
    
    temp_backup = os.path.join(AGY_DIR, "temp_current_token.bak")
    if os.path.exists(ACTIVE_TOKEN):
        shutil.move(ACTIVE_TOKEN, temp_backup)
    
    print("\n\033[1;33m[LANGKAH LOGIN AKUN BARU]\033[0m")
    print("Perintah `agy` akan diluncurkan.")
    print("Silakan buka tautan login di browser dan masuk dengan AKUN BARU Anda.")
    print("Setelah login selesai dan masuk ke prompt agy, ketik /exit untuk menyimpan.\n")
    
    input("Tekan [Enter] untuk mulai proses login...")
    try:
        subprocess.run(["agy"])
    except Exception as e:
        print(f"Error saat menjalankan agy: {e}")
    
    if os.path.exists(ACTIVE_TOKEN):
        new_email = get_email_from_token_file(ACTIVE_TOKEN)
        name = new_email if new_email else "akun_baru"
        dest = os.path.join(ACCOUNTS_DIR, f"{name}.token")
        shutil.copy2(ACTIVE_TOKEN, dest)
        print(f"\n🎉 Akun baru berhasil ditambahkan: \033[1;32m{new_email}\033[0m")
        print(f"Tersimpan di: {dest}")
    else:
        print("\n❌ Gagal mendeteksi token baru (mungkin proses dibatalkan).")
        if os.path.exists(temp_backup):
            shutil.move(temp_backup, ACTIVE_TOKEN)
            print("Token akun sebelumnya telah dipulihkan.")
        return
    
    if os.path.exists(temp_backup):
        os.remove(temp_backup)
    list_accounts()

def main():
    if len(sys.argv) < 2:
        list_accounts()
        print("Penggunaan: agy-account <perintah> [argumen]")
        print("  list              - Lihat semua akun dan status aktif")
        print("  add               - Tambah akun Google baru")
        print("  switch <no/email> - Pindah ke akun tertentu")
        print("  rotate            - Pindah otomatis ke akun berikutnya")
        print("  save [nama]       - Simpan token aktif saat ini")
        sys.exit(0)
    
    cmd = sys.argv[1].lower()
    if cmd in ("list", "ls"):
        list_accounts()
    elif cmd in ("add", "new"):
        add_account()
    elif cmd in ("switch", "use"):
        if len(sys.argv) < 3:
            list_accounts()
            try:
                pilih = input("Pilih nomor/email akun yang ingin diaktifkan: ").strip()
                if pilih:
                    switch_account(pilih)
            except (KeyboardInterrupt, EOFError):
                print("\nDibatalkan.")
        else:
            switch_account(sys.argv[2])
    elif cmd in ("rotate", "next"):
        rotate_account()
    elif cmd in ("save", "backup"):
        lbl = sys.argv[2] if len(sys.argv) > 2 else None
        save_current(lbl)
    else:
        print(f"Perintah '{cmd}' tidak dikenali. Jalankan 'agy-account' untuk bantuan.")

if __name__ == "__main__":
    main()

def print_list(lang="id"):
    clear_screen()
    t = TEXTS[lang]
    print(get_cat_banner(lang))
    sync_active_token()
    accounts = get_accounts()
    print(f"\n\033[1;36m================= {t['list_title']} =================\033[0m")
    if not accounts:
        print(f" {t['no_acc']}")
    else:
        for idx, acc in enumerate(accounts, 1):
            tag = f" \033[1;32m{t['active_tag']}\033[0m" if acc["is_active"] else ""
            print(f" \033[1;33m{idx}.\033[0m \033[1;37m{acc['email']}\033[0m{tag}")
            print(f"    \033[2mFile: {acc['file']} | Exp: {acc['expiry']}\033[0m")
    print("\033[1;36m" + "=" * (len(t['list_title']) + 36) + "\033[0m")
    print(f"\033[1;32m{t['total']}: {len(accounts)}\033[0m\n")

def ui_add_account(lang="id"):
    clear_screen()
    t = TEXTS[lang]
    print(get_cat_banner(lang))
    print(f"\n\033[1;32m{t['add_intro']}\033[0m")
    
    if os.path.exists(ACTIVE_TOKEN):
        curr_email = get_email_from_token_file(ACTIVE_TOKEN)
        curr_name = curr_email if curr_email else "current_account"
        save_current_token(curr_name)

    temp_backup = os.path.join(AGY_DIR, "temp_current_token.bak")
    if os.path.exists(ACTIVE_TOKEN):
        shutil.move(ACTIVE_TOKEN, temp_backup)

    print(f"\n\033[1;33m{t['add_notice']}\033[0m")
    print(t["add_step1"])
    print(t["add_step2"])
    print(t["add_step3"])
    print()

    input(f"\033[1;36m{t['add_press']}\033[0m")
    try:
        subprocess.run(["agy"])
    except Exception as e:
        print(f"Error: {e}")

    if os.path.exists(ACTIVE_TOKEN):
        new_email = get_email_from_token_file(ACTIVE_TOKEN)
        name = new_email if new_email else "new_account"
        dest = os.path.join(ACCOUNTS_DIR, f"{name}.token")
        shutil.copy2(ACTIVE_TOKEN, dest)
        print(f"\n\033[1;32m{t['add_success']} {new_email}\033[0m")
    else:
        print(f"\n\033[1;31m{t['add_failed']}\033[0m")
        if os.path.exists(temp_backup):
            shutil.move(temp_backup, ACTIVE_TOKEN)

    if os.path.exists(temp_backup):
        try:
            os.remove(temp_backup)
        except Exception:
            pass

def ui_remove_account(lang="id"):
    t = TEXTS[lang]
    print_list(lang)
    accounts = get_accounts()
    if not accounts:
        return

    choice = input(f"\033[1;33m{t['del_prompt']}\033[0m").strip()
    if not choice or choice == "0":
        print(f"\033[2m{t['del_cancel']}\033[0m")
        return

    target = None
    if choice.isdigit():
        idx = int(choice) - 1
        if 0 <= idx < len(accounts):
            target = accounts[idx]
    else:
        for acc in accounts:
            if choice.lower() in acc["email"].lower():
                target = acc
                break

    if not target:
        print(f"\033[1;31m{t['del_not_found']}\033[0m")
        return

    confirm = input(f"\033[1;31m{t['del_confirm'].format(target['email'])}\033[0m").strip().lower()
    if confirm in ("y", "yes", "ya"):
        was_active = target["is_active"]
        try:
            os.remove(target["path"])
            print(f"\033[1;32m{t['del_success'].format(target['email'])}\033[0m")
            if was_active:
                remaining = get_accounts()
                if remaining:
                    print(t["del_was_active"])
                    shutil.copy2(remaining[0]["path"], ACTIVE_TOKEN)
                    print(f"Aktif sekarang: {remaining[0]['email']}")
        except Exception as e:
            print(f"Error removing account: {e}")
    else:
        print(f"\033[2m{t['del_cancel']}\033[0m")

def interactive_loop():
    # 1. Pilih Bahasa (Layar bersih)
    clear_screen()
    print(get_cat_banner("id"))
    print("\n\033[1;36mPilih Bahasa / Select Language:\033[0m")
    print(" \033[1;33m1.\033[0m Bahasa Indonesia")
    print(" \033[1;33m2.\033[0m English")
    print("\033[2m───────────────────────────────────────────────\033[0m")
    print("\033[2m(Tekan Ctrl+C untuk keluar / Press Ctrl+C to exit)\033[0m")
    print("\033[2m───────────────────────────────────────────────\033[0m")
    lang_choice = input("Pilih [1/2] (default: 1): ").strip()
    lang = "en" if lang_choice == "2" else "id"

    t = TEXTS[lang]
    err_msg = ""

    # 2. Menu Utama (Setiap aksi membersihkan layar agar tetap di tempat)
    while True:
        clear_screen()
        print(get_cat_banner(lang))
        print(f"\n\033[1;34m{t['menu_title']}\033[0m")
        print("\033[1;34m───────────────────────────────────────────────\033[0m")
        print(f" \033[1;37m1.\033[0m {t['opt1']}")
        print(f" \033[1;37m2.\033[0m {t['opt2']}")
        print(f" \033[1;37m3.\033[0m {t['opt3']}")
        print(f" \033[1;37m4.\033[0m {t['opt4']}")
        print("\033[2m───────────────────────────────────────────────\033[0m")
        print(f" {t['ctrl_c_hint']}")
        print("\033[2m───────────────────────────────────────────────\033[0m")
        if err_msg:
            print(f"\033[1;31m{err_msg}\033[0m\n")
            err_msg = ""

        choice = input(t["choose"]).strip()

        if choice == "1":
            ui_add_account(lang)
            input(f"\n\033[2m{t['press_enter']}\033[0m")
        elif choice == "2":
            ui_remove_account(lang)
            input(f"\n\033[2m{t['press_enter']}\033[0m")
        elif choice == "3":
            print_list(lang)
            input(f"\033[2m{t['press_enter']}\033[0m")
        elif choice == "4":
            clear_screen()
            print(get_cat_banner(lang))
            print("\nSampai jumpa! / Goodbye!\n")
            break
        else:
            err_msg = t["invalid"]

# ----------------- CLI Argument Handler -----------------

def main():
    try:
        if len(sys.argv) == 1:
            interactive_loop()
            return

        arg1 = sys.argv[1].lower()

        if arg1 in ("--rotate", "rotate"):
            ok, res = rotate_account_internal()
            if ok:
                print(f"OK:{res}")
                sys.exit(0)
            else:
                print(f"ERR:{res}", file=sys.stderr)
                sys.exit(1)

        elif arg1 in ("--switch", "switch"):
            if len(sys.argv) < 3:
                print("ERR:Target account required", file=sys.stderr)
                sys.exit(1)
            ok, res = switch_account_internal(sys.argv[2])
            if ok:
                print(f"OK:{res}")
                sys.exit(0)
            else:
                print(f"ERR:{res}", file=sys.stderr)
                sys.exit(1)

        elif arg1 in ("--list-json", "list-json"):
            sync_active_token()
            accs = get_accounts()
            print(json.dumps(accs, indent=2))
            sys.exit(0)

        elif arg1 in ("--list", "list"):
            print_list("id")
            sys.exit(0)

        elif arg1 in ("--active-email", "active-email"):
            sync_active_token()
            email = get_email_from_token_file(ACTIVE_TOKEN)
            print(email or "None")
            sys.exit(0)

        else:
            interactive_loop()

    except (KeyboardInterrupt, EOFError):
        clear_screen()
        print("\nKeluar dari program (Ctrl+C). Sampai jumpa! / Goodbye!\n")
        sys.exit(0)

if __name__ == "__main__":
    main()

#!/usr/bin/env bash
# agy-claude: Antigravity runner with auto-rotation for Claude Opus & Sonnet
set -e

MODEL="claude-opus-4-6-thinking"

# Cek argumen
ARGS=()
for arg in "$@"; do
  case "$arg" in
    --sonnet)
      MODEL="claude-sonnet-4-6"
      ;;
    --opus)
      MODEL="claude-opus-4-6-thinking"
      ;;
    *)
      ARGS+=("$arg")
      ;;
  esac
done

echo -e "\033[1;34m========================================================\033[0m"
echo -e "\033[1;32m  Antigravity Claude Auto-Runner (Opus/Sonnet Rotator)  \033[0m"
echo -e "  Model: \033[1;33m$MODEL\033[0m"
echo -e "\033[1;34m========================================================\033[0m"

# Tampilkan akun yang aktif jika agy-account tersedia
if command -v agy-account >/dev/null 2>&1; then
  agy-account list | grep "\[AKTIF\]" || true
fi

# Jalankan sesi pertama
echo -e "\n\033[1;32m[1/2] Memulai sesi dengan model $MODEL...\033[0m"
agy --model "$MODEL" "${ARGS[@]}" || true

# Loop auto-rotate jika sesi keluar / limit
while true; do
  echo -e "\n\033[1;33m--------------------------------------------------------\033[0m"
  echo -e "Sesi selesai atau kuota model mungkin telah mencapai limit."
  read -p "Tekan [Enter] untuk ganti akun & LANJUTKAN task, atau 'q' untuk selesai: " choice
  
  if [ "$choice" = "q" ] || [ "$choice" = "Q" ]; then
    echo "Selesai."
    break
  fi

  # Lakukan rotasi akun
  echo -e "\n\033[1;36m[Auto-Switch] Melakukan rotasi ke akun berikutnya...\033[0m"
  if command -v agy-account >/dev/null 2>&1; then
    agy-account rotate || {
      echo "Gagal rotasi akun. Pastikan Anda sudah menambahkan minimal 2 akun via 'agy-account add'."
      break
    }
  else
    echo "Perintah agy-account tidak ditemukan di PATH."
    break
  fi

  echo -e "\033[1;32m[Auto-Switch] Melanjutkan task terakhir dengan akun baru (agy --continue)...\033[0m\n"
  agy --model "$MODEL" --continue || true
done
